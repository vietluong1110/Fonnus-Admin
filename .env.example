# The only credential this repo holds: the read-only Postgres role `console`,
# created by the pipeline repo's migration 0006 and given a password by hand on
# the box (../Fonnus/docs/runbook.md §9). Never the `fonnus` superuser.
#
# Local development through an SSH tunnel (see README.md):
#   DATABASE_URL=postgres://console:<password>@127.0.0.1:15432/fonnus
# On the box, as a container on the pipeline's network `fonnus_default`:
#   DATABASE_URL=postgres://console:<password>@postgres:5432/fonnus
DATABASE_URL=

# Arrives with the artifact bucket (../Fonnus/PLAN.md row W2-L1): a read-only key
# on the Vietnix S3 bucket. Not used by anything yet. Endpoint and region are the ones
# the pipeline's spike verified (../Fonnus/docs/research/2026-09-07-vietnix-s3-spike.md).
# S3_ENDPOINT=https://s3.vn-hcm-1.vietnix.cloud
# S3_REGION=vn-hcm-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_INTERNAL=calls-internal
# S3_BUCKET_PATIENT=calls-patient
