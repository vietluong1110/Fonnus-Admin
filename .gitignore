# Secrets & machine-specific. The glob also covers .env.bak / .env.prod / .env.local.
.env*
!.env.example

# The Caddy basic_auth accounts: one `<name> <bcrypt hash>` line per team member,
# hand-maintained on the box (docs/deploy.md §4). A throwaway copy made locally for
# a `caddy validate` run must never be committed either.
caddy/users

# The product owner's design artboards (docs/redesign.md): handed over outside git,
# kept locally only — the documents about them are tracked, the mockups are not.
docs/design/

# Call artifacts must never land on a tracked path, whatever tool wrote them
# (same backstop as the pipeline repo).
*.wav
*.raw
**/events.jsonl
**/call.json

# Node / Next.js
node_modules/
.next/
out/
dist/
*.tsbuildinfo
# Regenerated by `next build` / `next dev`; Next.js ships it gitignored.
next-env.d.ts
